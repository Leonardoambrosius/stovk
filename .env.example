# ============================================================================
# ENVIRONMENT VARIABLES - TEMPLATE
# ============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
#
# Get values from:
# - Clerk: https://dashboard.clerk.com
# - Asaas: https://app.asaas.com
# - Neon: https://console.neon.tech
# ============================================================================

# ============================================================================
# DATABASE - POSTGRESQL
# ============================================================================
# Get from Neon dashboard:
# https://console.neon.tech/app/projects
DATABASE_URL="postgresql://user:password@host.neon.tech/database?sslmode=require"

# ============================================================================
# CLERK AUTHENTICATION
# ============================================================================
# Get from: https://dashboard.clerk.com/apps/your-app/api-keys

# Public key (safe to expose)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"

# Secret key (KEEP SECRET - never expose to client)
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"

# Webhook secret for user.created events
# Get from: https://dashboard.clerk.com/webhooks
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"

# ============================================================================
# ASAAS PAYMENT GATEWAY
# ============================================================================
# Get from: https://app.asaas.com/settings/integrations/api

# API key for Asaas requests (KEEP SECRET)
ASAAS_API_KEY="sk_live_xxxxxxxxxxxxxxxxxxxxx"

# Webhook secret for payment events
# Get from Asaas webhook configuration
# Get via Svix integration at: https://app.asaas.com/webhooks
SVIX_ASAAS_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxx"

# Asaas API endpoint (production)
NEXT_PUBLIC_ASAAS_API_URL="https://api.asaas.com/v3"

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Your production domain
NEXT_PUBLIC_APP_DOMAIN="aurenstockos.online"

# Full app URL with protocol
NEXT_PUBLIC_APP_URL="https://aurenstockos.online"

# Clerk UI redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ============================================================================
# ENVIRONMENT & LOGGING
# ============================================================================

# Node environment
NODE_ENV="production"

# App environment (mirrors NODE_ENV, for clarity)
NEXT_PUBLIC_ENVIRONMENT="production"

# Log level: debug, info, warn, error
LOG_LEVEL="info"

# ============================================================================
# OPTIONAL - ERROR TRACKING
# ============================================================================
# Uncomment to enable Sentry error tracking
# SENTRY_DSN="https://your-key@sentry.io/your-project-id"

# ============================================================================
# IMPORTANT SECURITY NOTES
# ============================================================================
#
# 1. NEVER commit this file to git
#    Add to .gitignore: .env.local
#
# 2. Variables with NEXT_PUBLIC_ prefix are visible in browser
#    Only use for non-sensitive values
#
# 3. Secrets (keys starting with sk_, whsec_) MUST use production versions
#    in production, NEVER use test keys
#
# 4. Each deployment platform handles env vars differently:
#    - Vercel: Settings > Environment Variables
#    - Railway: Variables tab
#    - Heroku: Config Vars
#    - Docker: -e flag or .env file
#
# 5. Rotate secrets periodically:
#    - Create new webhook secrets in Clerk/Asaas
#    - Update environment variables
#    - Test webhooks with new secrets
#    - Delete old secrets
#
# 6. Audit who has access to these variables
#    - Limit to deployment personnel
#    - Use separate accounts for staging/production
#    - Enable MFA for all admin accounts
#
# ============================================================================
