generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plano {
  FREE
  PRO
}

enum Role {
  ADMIN
  FUNCIONARIO
}

enum StatusOS {
  ABERTA
  ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Empresa {
  id               Int      @id @default(autoincrement())
  asaas_customer_id String?
  nome             String
  plano            Plano    @default(FREE)
  limite_produtos  Int      @default(50)
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  usuarios         Usuario[]
  produtos         Produto[]
  ordensServico    OrdemServico[]

  @@index([id])
}

model Usuario {
  id         String @id // Clerk user ID
  empresa_id Int
  email      String @unique
  role       Role   @default(FUNCIONARIO)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa    Empresa @relation(fields: [empresa_id], references: [id])

  @@index([empresa_id])
}

model Produto {
  id               Int      @id @default(autoincrement())
  empresa_id       Int
  nome             String
  modelo           String?
  categoria        String?
  valor_custo      Decimal   @db.Decimal(10,2)
  valor_venda      Decimal   @db.Decimal(10,2)
  quantidade_atual Int      @default(0)
  estoque_minimo   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  empresa          Empresa @relation(fields: [empresa_id], references: [id])
  itensOS          ItemOS[]

  @@index([empresa_id])
}

model OrdemServico {
  id           Int      @id @default(autoincrement())
  empresa_id   Int
  cliente_nome String
  status       StatusOS @default(ABERTA)
  descricao    String?
  valor_total  Decimal   @default(0) @db.Decimal(10,2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa      Empresa @relation(fields: [empresa_id], references: [id])
  itens        ItemOS[]

  @@index([empresa_id])
}

model ItemOS {
  id            Int      @id @default(autoincrement())
  os_id        Int
  produto_id   Int
  quantidade   Int
  valor_unitario Decimal @db.Decimal(10,2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordemServico OrdemServico @relation(fields: [os_id], references: [id])
  produto     Produto @relation(fields: [produto_id], references: [id])

  @@index([os_id])
  @@index([produto_id])
}
